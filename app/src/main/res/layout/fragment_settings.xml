<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mainBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="?attr/titleTextColor"
                android:textSize="24sp"
                android:fontFamily="?attr/fontLight"
                android:layout_marginBottom="24dp"/>

            <!-- NYTT: TEMA-VÄLJARE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/history_item_background"
                android:backgroundTint="?attr/colorSurface"
                android:elevation="0dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_theme_title"
                    android:textColor="?attr/sectionHeaderTextColor"
                    android:textSize="13sp"
                    android:fontFamily="?attr/fontBold"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleGroupTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeClassic"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_classic"
                        android:textColor="?attr/secondaryTextColorCustom"
                        app:strokeColor="?attr/secondaryTextColorCustom"
                        android:textSize="12sp"
                        android:fontFamily="?attr/fontBold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeModern"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_modern"
                        android:textColor="?attr/secondaryTextColorCustom"
                        app:strokeColor="?attr/secondaryTextColorCustom"
                        android:textSize="12sp"
                        android:fontFamily="?attr/fontBold" />

                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardAutoRevokeWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/history_item_background"
                android:backgroundTint="?attr/colorSurface"
                android:elevation="0dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/warning_auto_revoke_title"
                    android:textColor="?attr/sectionHeaderTextColor"
                    android:textSize="13sp"
                    android:fontFamily="?attr/fontBold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/warning_auto_revoke_msg"
                    android:textColor="?attr/mutedTextColorOnSurface"
                    android:textSize="14sp"
                    android:fontFamily="?attr/fontRegular"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnFixAutoRevoke"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_fix_auto_revoke"
                    android:textColor="@color/text_main"
                    app:strokeColor="@color/text_main"
                    android:fontFamily="?attr/fontBold"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/history_item_background"
                android:backgroundTint="?attr/colorSurface"
                android:elevation="0dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_smarthelp_title"
                    android:textColor="?attr/sectionHeaderTextColor"
                    android:textSize="13sp"
                    android:fontFamily="?attr/fontBold"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleGroupSmartHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeOff"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/toggle_off"
                        android:textColor="?attr/secondaryTextColorCustom"
                        app:strokeColor="?attr/secondaryTextColorCustom"
                        android:fontFamily="?attr/fontBold"
                        android:textSize="12sp"
                        tools:ignore="UnusedAttribute" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeEmployee"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_mode_employee"
                        android:textColor="?attr/secondaryTextColorCustom"
                        app:strokeColor="?attr/secondaryTextColorCustom"
                        android:textSize="12sp"
                        android:fontFamily="?attr/fontBold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeConsultant"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_mode_consultant"
                        android:textColor="?attr/secondaryTextColorCustom"
                        app:strokeColor="?attr/secondaryTextColorCustom"
                        android:textSize="12sp"
                        android:fontFamily="?attr/fontBold" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/txtSmartHelpDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_smarthelp_desc"
                    android:textColor="?attr/mutedTextColorOnSurface"
                    android:textSize="11sp"
                    android:fontFamily="?attr/fontRegular"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/history_item_background"
                android:backgroundTint="?attr/colorSurface"
                android:elevation="0dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_calendar_title"
                    android:textColor="?attr/sectionHeaderTextColor"
                    android:textSize="13sp"
                    android:fontFamily="?attr/fontBold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/toggle_off"
                        android:textSize="14sp"
                        android:fontFamily="?attr/fontSemiBold"
                        android:textColor="?attr/spinnerTextColor" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchCalendarIntegration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        app:trackTint="@color/sunset_orange"
                        app:thumbTint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/toggle_on"
                        android:textSize="14sp"
                        android:fontFamily="?attr/fontSemiBold"
                        android:textColor="@color/text_main" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardConsultantGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/history_item_background"
                android:backgroundTint="?attr/colorSurface"
                android:elevation="0dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_consultant_goal_title"
                    android:textColor="?attr/sectionHeaderTextColor"
                    android:textSize="13sp"
                    android:fontFamily="?attr/fontBold"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etConsultantMonthlyGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/spinnerTextColor"
                    android:backgroundTint="?attr/spinnerTextColor"
                    android:inputType="number"
                    android:hint="@string/settings_consultant_goal_hint"
                    android:textColorHint="@color/modern_text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="?attr/fontRegular"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/history_item_background"
                android:backgroundTint="?attr/colorSurface"
                android:elevation="0dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/txtWorkplacesHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_workplaces_title"
                    android:textColor="?attr/sectionHeaderTextColor"
                    android:textSize="13sp"
                    android:fontFamily="?attr/fontBold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:id="@+id/rowAddWorkplace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/etWorkplaceName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/settings_workplace_name_hint"
                        android:textColor="?attr/spinnerTextColor"
                        android:backgroundTint="?attr/spinnerTextColor"
                        android:textColorHint="@color/modern_text_secondary"
                        android:textSize="14sp"
                        android:inputType="textCapWords"
                        android:fontFamily="?attr/fontRegular"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddWorkplace"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:enabled="false"
                        android:alpha="0.3"
                        android:text="@string/btn_add_workplace"
                        android:textSize="12sp"
                        android:fontFamily="?attr/fontRegular"
                        android:backgroundTint="@color/text_dark_gray"
                        android:textColor="@color/white"
                        android:layout_marginStart="8dp"
                        app:cornerRadius="8dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llWorkplacesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#15000000"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_defaults_title"
                    android:textColor="?attr/sectionHeaderTextColor"
                    android:textSize="13sp"
                    android:fontFamily="?attr/fontBold"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_daily_goal_title"
                    android:textColor="?attr/spinnerTextColor"
                    android:textSize="14sp"
                    android:fontFamily="?attr/fontSemiBold"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etDailyGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/spinnerTextColor"
                    android:backgroundTint="?attr/spinnerTextColor"
                    android:inputType="number"
                    android:hint="@string/settings_daily_goal_hint"
                    android:textColorHint="@color/modern_text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="?attr/fontRegular"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_lunch_minutes_title"
                    android:textColor="?attr/spinnerTextColor"
                    android:textSize="14sp"
                    android:fontFamily="?attr/fontSemiBold"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etLunchMinutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/spinnerTextColor"
                    android:backgroundTint="?attr/spinnerTextColor"
                    android:inputType="number"
                    android:hint="@string/settings_lunch_minutes_hint"
                    android:textColorHint="@color/modern_text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="?attr/fontRegular"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_rounding_title"
                    android:textColor="?attr/spinnerTextColor"
                    android:textSize="14sp"
                    android:fontFamily="?attr/fontSemiBold"
                    android:layout_marginBottom="4dp"/>

                <Spinner
                    android:id="@+id/spRounding"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="?attr/spinnerTextColor"
                    android:popupBackground="?attr/colorSurface"/>
            </LinearLayout>

            <!-- NYTT: BACKUP SEKTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/history_item_background"
                android:backgroundTint="?attr/colorSurface"
                android:elevation="0dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SÄKERHETSKOPIA"
                    android:textColor="?attr/sectionHeaderTextColor"
                    android:textSize="13sp"
                    android:fontFamily="?attr/fontBold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Spara din historik till en fil. Du kan välja din Nextcloud-mapp eller annan molntjänst."
                    android:textColor="?attr/mutedTextColorOnSurface"
                    android:textSize="12sp"
                    android:fontFamily="?attr/fontRegular"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportBackup"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SKAPA BACKUP-FIL"
                    android:textColor="?attr/spinnerTextColor"
                    app:strokeColor="?attr/accentColorCustom"
                    android:fontFamily="?attr/fontBold"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportBackup"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="LÄS IN BACKUP-FIL"
                    android:textColor="?attr/spinnerTextColor"
                    app:strokeColor="?attr/accentColorCustom"
                    android:fontFamily="?attr/fontBold"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveSettings"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="@string/settings_save_button"
                android:fontFamily="?attr/fontRegular"
                android:backgroundTint="@color/text_dark_gray"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
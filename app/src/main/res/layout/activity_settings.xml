<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sunset_gradient">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/sunset_text_main"
                android:textSize="24sp"
                android:fontFamily="@font/asap_black"
                android:layout_marginBottom="24dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/history_item_background"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_smarthelp_title"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:fontFamily="@font/asap_black"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleGroupSmartHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeOff"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/toggle_off"
                        android:textColor="@color/text_main"
                        app:strokeColor="@color/text_main"
                        android:fontFamily="@font/asap_black"
                        tools:ignore="UnusedAttribute" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeEmployee"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_mode_employee"
                        android:textColor="@color/text_main"
                        app:strokeColor="@color/text_main"
                        android:fontFamily="@font/asap_black" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeConsultant"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_mode_consultant"
                        android:textColor="@color/text_main"
                        app:strokeColor="@color/text_main"
                        android:fontFamily="@font/asap_black" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/txtSmartHelpDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_smarthelp_desc"
                    android:textColor="#424242"
                    android:textSize="14sp"
                    android:fontFamily="@font/asap_light"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/history_item_background"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_calendar_title"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:fontFamily="@font/asap_black"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/toggle_off"
                        android:textSize="14sp"
                        android:fontFamily="@font/asap_semibold"
                        android:textColor="@color/text_dark_gray" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchCalendarIntegration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        app:trackTint="@color/sunset_orange"
                        app:thumbTint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/toggle_on"
                        android:textSize="14sp"
                        android:fontFamily="@font/asap_semibold"
                        android:textColor="@color/text_main" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardConsultantGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/history_item_background"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_consultant_goal_title"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:fontFamily="@font/asap_black"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etConsultantMonthlyGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/dialog_input_text"
                    android:backgroundTint="@color/text_main"
                    android:inputType="number"
                    android:hint="@string/settings_consultant_goal_hint"
                    android:textColorHint="#60212121"
                    android:fontFamily="@font/asap_light"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/history_item_background"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/txtWorkplacesHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_workplaces_title"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:fontFamily="@font/asap_black"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:id="@+id/rowAddWorkplace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/etWorkplaceName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/settings_workplace_name_hint"
                        android:textColor="@color/dialog_input_text"
                        android:backgroundTint="@color/text_main"
                        android:textColorHint="#60212121"
                        android:inputType="textCapWords"
                        android:fontFamily="@font/asap_light"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddWorkplace"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="+"
                        android:textSize="20sp"
                        android:fontFamily="@font/asap_black"
                        android:backgroundTint="@color/sunset_orange"
                        android:textColor="@color/sunset_text_main"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingTop="0dp"
                        android:paddingBottom="2dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        app:cornerRadius="18dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llWorkplacesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#15000000"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_defaults_title"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:fontFamily="@font/asap_black"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_daily_goal_title"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:fontFamily="@font/asap_semibold"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etDailyGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/dialog_input_text"
                    android:backgroundTint="@color/text_main"
                    android:inputType="number"
                    android:fontFamily="@font/asap_light"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_lunch_minutes_title"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:fontFamily="@font/asap_semibold"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etLunchMinutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/dialog_input_text"
                    android:backgroundTint="@color/text_main"
                    android:inputType="number"
                    android:fontFamily="@font/asap_light"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_rounding_title"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:fontFamily="@font/asap_semibold"
                    android:layout_marginBottom="4dp"/>

                <Spinner
                    android:id="@+id/spRounding"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/text_main"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveSettings"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="@string/settings_save_button"
                android:fontFamily="@font/asap_black"
                android:backgroundTint="@color/sunset_orange"
                android:textColor="@color/sunset_text_main"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
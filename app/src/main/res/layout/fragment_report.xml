<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mainBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtReportTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/fontLight"
                android:text="@string/report_title"
                android:textColor="?attr/titleTextColor"
                android:textSize="24sp"
                android:layout_marginBottom="24dp"/>

            <!-- NYTT: STAPELDIAGRAM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/history_item_background"
                android:backgroundTint="?attr/colorSurface"
                android:elevation="0dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ARBETADE TIMMAR PER VECKA"
                    android:textColor="?attr/cardHeaderTextColor"
                    android:textSize="13sp"
                    android:fontFamily="?attr/fontBold"
                    android:layout_marginBottom="8dp"/>

                <com.dinatid.arbetslogg.ui.WorkBarChart
                    android:id="@+id/workBarChart"
                    android:layout_width="match_parent"
                    android:layout_height="180dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/history_item_background"
                android:backgroundTint="?attr/colorSurface"
                android:elevation="0dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/txtWeeklyTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="?attr/fontBold"
                    android:text="@string/report_weekly_total_placeholder"
                    android:textColor="?attr/cardHeaderTextColor"
                    android:textSize="16sp"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/llWeeklyWorkplaces"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/history_item_background"
                android:backgroundTint="?attr/colorSurface"
                android:elevation="0dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/txtMonthlyTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="?attr/fontBold"
                    android:text="@string/report_monthly_total_placeholder"
                    android:textColor="?attr/cardHeaderTextColor"
                    android:textSize="16sp"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/llMonthlyWorkplaces"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <Button
                android:id="@+id/btnExportReport"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="@color/text_dark_gray"
                android:fontFamily="?attr/fontRegular"
                android:text="@string/report_export_all"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/txtNoWorkplaceWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/fontRegular"
                android:text="@string/report_no_workplaces_msg"
                android:textColor="#FCDEBB"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="24dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
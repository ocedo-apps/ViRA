<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="@drawable/bg_bottom_nav"
    android:orientation="horizontal"
    android:weightSum="4">

    <LinearLayout
        android:id="@+id/btnNavDashboard"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:orientation="vertical"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/outline_calendar_apps_script_24"
            app:tint="@color/sunset_text_main" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/asap_light"
            android:text="@string/nav_dashboard"
            android:textColor="@color/sunset_text_main"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnNavHistory"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:orientation="vertical"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/outline_calendar_clock_24"
            app:tint="@color/sunset_text_main" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/asap_light"
            android:text="@string/nav_calendar"
            android:textColor="@color/sunset_text_main"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnNavReports"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:orientation="vertical"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/outline_analytics_24"
            app:tint="@color/sunset_text_main" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/asap_light"
            android:text="@string/nav_reports"
            android:textColor="@color/sunset_text_main"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnNavSettings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:orientation="vertical"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/sunset_text_main" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/asap_light"
            android:text="@string/nav_settings"
            android:textColor="@color/sunset_text_main"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mainBackground"
    tools:context=".ui.DashboardFragment">

    <LinearLayout
        android:id="@+id/datePickerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnPrevDay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_previous"
            app:tint="?attr/arrowTintColor" />

        <TextView
            android:id="@+id/txtCurrentDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="?attr/fontLight"
            android:gravity="center"
            android:text="IDAG"
            android:textColor="?attr/titleTextColor"
            android:textSize="24sp" />

        <ImageView
            android:id="@+id/btnNextDay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_next"
            app:tint="?attr/arrowTintColor" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardPermissionWarning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/history_item_background"
        android:backgroundTint="#FFEBEE"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/datePickerContainer">

        <TextView
            android:id="@+id/txtPermissionWarningTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="?attr/fontBold"
            android:text="@string/warning_permission_title"
            android:textColor="#B71C1C"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtPermissionWarningMsg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="?attr/fontRegular"
            android:text="@string/warning_permission_both"
            android:textColor="#B71C1C"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtPermissionWarningTitle" />

        <Button
            android:id="@+id/btnFixPermissions"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#B71C1C"
            android:fontFamily="?attr/fontRegular"
            android:text="@string/btn_fix_permissions"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtPermissionWarningMsg" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clockCircle"
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:layout_constraintBottom_toTopOf="@+id/txtStatusMessage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/datePickerContainer"
        android:background="@drawable/bg_clock_ring"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.28">

        <ImageView
            android:id="@+id/imgSpinningSnake"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="12dp"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/txtCountdownLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/fontBold"
                android:text="WIFI TAPPAT!" android:textColor="#F44336"
                android:textSize="14sp"
                android:layout_marginBottom="2dp" android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtCurrentSsid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/fontRegular"
                android:gravity="center"
                android:text="Utcheckad."
                android:textColor="?attr/secondaryTextColorCustom"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtCurrentWorkplace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/fontBold"
                android:gravity="center"
                android:text="Järven"
                android:textColor="?attr/secondaryTextColorCustom"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtCenterTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/fontBold"
                android:includeFontPadding="false"
                android:text="00:00"
                android:textColor="?attr/secondaryTextColorCustom"
                android:textSize="54sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtInTimeCircle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="?attr/fontRegular"
                android:text="---"
                android:textColor="?attr/secondaryTextColorCustom"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txtStatusMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:fontFamily="?attr/fontBold"
        android:gravity="center"
        android:text="VÄLKOMMEN TILLBAKA!"
        android:textColor="?attr/secondaryTextColorCustom"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/toggleContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clockCircle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toggleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        app:layout_constraintBottom_toTopOf="@+id/monthCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtStatusMessage">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchManualToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/white"
            app:trackTint="@color/accent_orange"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="0.32" />

        <TextView
            android:id="@+id/txtToggleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="?attr/fontBold"
            android:text="UTCHECKAD (MANUELL)"
            android:textColor="?attr/secondaryTextColorCustom"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/switchManualToggle"
            app:layout_constraintStart_toEndOf="@id/switchManualToggle"
            app:layout_constraintTop_toTopOf="@id/switchManualToggle" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/monthCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/history_item_background"
        android:backgroundTint="?attr/colorSurface"
        android:elevation="0dp"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toggleContainer">

        <TextView
            android:id="@+id/lblMonthTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="?attr/fontBold"
            android:text="DENNA MÅNADEN"
            android:textColor="?attr/spinnerTextColor"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtMonthBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="?attr/fontBold"
            android:text="-55h 04m"
            android:textColor="?attr/spinnerTextColor"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/lblMonthTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/lblMonthTitle" />

        <ProgressBar
            android:id="@+id/progressActualMonth"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginTop="16dp"
            android:progress="35"
            android:progressBackgroundTint="#40000000"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblMonthTitle" />

        <LinearLayout
            android:id="@+id/goalIndicatorContainer"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:orientation="horizontal"
            android:layout_marginTop="-16dp"
            app:layout_constraintEnd_toEndOf="@+id/progressActualMonth" app:layout_constraintStart_toStartOf="@+id/progressActualMonth" app:layout_constraintTop_toBottomOf="@+id/progressActualMonth">

            <View
                android:id="@+id/goalLeftSpace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="50" />

            <View
                android:id="@+id/goalLine"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="?attr/spinnerTextColor" />

            <View
                android:id="@+id/goalRightSpace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="50" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
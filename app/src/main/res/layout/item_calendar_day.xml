<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dayContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="85dp"
    android:layout_margin="2dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/txtDayNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:fontFamily="?attr/fontBold"
        android:text="15"
        android:textColor="?attr/spinnerTextColor"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtLoggedTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:fontFamily="?attr/fontBold"
        android:text="8h"
        android:textColor="?attr/titleTextColor"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtLunch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:fontFamily="?attr/fontSemiBold"
        android:text=""
        android:textColor="@color/warning_red"
        android:textSize="9sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtExternalEvent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:fontFamily="?attr/fontSemiBold"
        android:text=""
        android:textColor="?attr/spinnerTextColor"
        android:textSize="9sp"
        android:visibility="gone" />

</LinearLayout>